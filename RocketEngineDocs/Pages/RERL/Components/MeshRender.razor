@page "/RERL/Components/MeshRenderer"
@using RocketEngineDocs.Components
@implements IDocPage

@using static RocketEngineDocs.Components.DocBuilder

@code {
    RenderFragment doc;
    DocBuilder builder;

    public DocBuilder BuildDoc()
    {
        return DocBuilder.Create("/RERL/Components/MeshRenderer")
            .Title("MeshRenderer")
            .Subtitle("Updated for v0.2.0")
            .Namespace("RERL.Components")
            .Library("RERL")
            .Paragraph("A component that renders a mesh using a shader. Handles VAO/VBO/IBO creation, uniform setup, and instanced rendering. This component is marked as Obsolete and may be removed or replaced in future versions.")
            .Members(m => m

                // === Fields ===
                .Field("Entity", "Owner", "The entity that owns this component.")
                .Field("bool", "AutoRegister", "Whether this renderer automatically registers itself with the RenderPipeline.")

                // === Methods ===

                .Method("MeshRenderer", "SetAutoRegister(bool autoRegister)", "Sets whether this renderer should automatically register itself.", mb => mb
                    .Parameter("autoRegister:", "Whether auto‑registration should be enabled.")
                )

                .Method("MeshRenderer", "AttachMesh(Mesh mesh)", "Attaches a mesh to this renderer.", mb => mb
                    .Parameter("mesh:", "The mesh to attach.")
                )

                .Method("MeshRenderer", "AttachShader(Shader shader, bool buildMeshBuffers)", "Attaches a shader to this renderer.", mb => mb
                    .Parameter("shader:", "The shader to attach.")
                    .Parameter("buildMeshBuffers:", "Whether mesh buffers should be built immediately.")
                )

                .Method("Mesh?", "GetMesh()", "Gets the attached mesh.")

                .Method("Shader?", "GetShader()", "Gets the attached shader.")

                .Method("void", "OnAdd()", "Called when the component is added to an entity. Registers with the RenderPipeline if AutoRegister is enabled.")

                .Method("bool", "BuildMeshBuffers(bool silence)", "Builds the VAO, VBO, and IBO for the attached mesh.", mb => mb
                    .Parameter("silence:", "If true, missing mesh errors are ignored.")
                    .Exception("Thrown if the mesh is null and silence is false.")
                )

                .Method("void", "RebuildMaterialSSBO()", "Rebuilds the material SSBO. (Currently empty placeholder method.)")

                .Method("void", "Render(int instanceCount)", "Renders the mesh using the attached shader and the owner's Transform.", mb => mb
                    .Parameter("instanceCount:", "The number of instances to draw.")
                    .Exception("Thrown if the mesh or shader is null.")
                )

                .Method("void", "DisposeBuffers()", "Deletes the VAO, VBO, and IBO associated with this mesh.")

                .Method("void", "Load()", "Called when the scene is loaded.")

                .Method("void", "Update(float deltaTime)", "Updates the component. (Currently unused.)", mb => mb
                    .Parameter("deltaTime:", "Time elapsed since the last update.")
                )
            );
    }

    protected override void OnInitialized()
    {
        builder = BuildDoc();
        doc = builder.Build();
