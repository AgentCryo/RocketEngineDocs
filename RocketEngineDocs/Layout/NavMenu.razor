@using RocketEngineDocs.Components
<nav class="nav flex-column">
    @foreach (var node in NavRegistry.Roots.ToArray())
    {
        <NavItem Node="node" />
    }
</nav>

@code {
    
    public static class NavRegistry
    {
        public static event Action? OnChanged;
        static Dictionary<string, NavItem.NavNode> NavItems { get; } = [];
        public static List<NavItem.NavNode> Roots = [];

        public static void RegisterDoc(DocBuilder doc)
        {
            RegisterPath(doc.DisplayName, doc.WebAddress, order: 100);
            UpdateRoots();
            OnChanged?.Invoke();
        }

        public static void RegisterStatic(string displayName, string url, int order = 0)
        {
            RegisterPath(displayName, url, order);
            UpdateRoots();
            OnChanged?.Invoke();
        }

        private static void UpdateRoots() =>
            Roots = NavItems.Values
                // Root = no slash in the *public* URL (API, Guides, RCS, RERL)
                .Where(n => !n.URL.Contains('/'))
                .OrderBy(n => n.Order)
                .ThenBy(n => n.DisplayName)
                .ToList();

        private static NavItem.NavNode RegisterPath(string displayName, string url, int order)
        {
            // Normalize input: allow "API", "/API", "Guides/GettingStarted", "/Guides/GettingStarted"
            var normalized = url.Trim('/');
            var segments = normalized.Split('/', StringSplitOptions.RemoveEmptyEntries);

            // INTERNAL KEY (absolute, used for tree structure)
            string currentKey = "";
            // PUBLIC URL (relative, used for links)
            string currentUrl = "";

            NavItem.NavNode? lastFolder = null;

            // Build folder hierarchy for all but the last segment
            for (int i = 0; i < segments.Length - 1; i++)
            {
                // internal absolute key: /Guides, /Guides/GettingStarted, etc.
                currentKey = currentKey + "/" + segments[i];

                // public relative URL: Guides, Guides/GettingStarted, etc.
                currentUrl = (currentUrl == "")
                    ? segments[i]
                    : $"{currentUrl}/{segments[i]}";

                if (!NavItems.TryGetValue(currentKey, out var folderNode))
                {
                    folderNode = new NavItem.NavNode
                    {
                        DisplayName = segments[i],
                        URL = currentUrl,   // relative
                        HasPage = false,
                        Order = order
                    };

                    NavItems[currentKey] = folderNode;
                    lastFolder?.Children.Add(folderNode);
                }

                lastFolder = folderNode;
            }

            // Final node
            string finalKey = "/" + string.Join("/", segments); // absolute key
            string finalUrl = normalized;                       // relative URL

            if (NavItems.TryGetValue(finalKey, out var existingNode))
            {
                existingNode.DisplayName = displayName;
                existingNode.URL = finalUrl;   // relative
                existingNode.HasPage = true;
                existingNode.Order = order;
                return existingNode;
            }
            else
            {
                var finalNode = new NavItem.NavNode
                {
                    DisplayName = displayName,
                    URL = finalUrl,             // relative
                    HasPage = true,
                    Order = order
                };

                NavItems[finalKey] = finalNode;
                lastFolder?.Children.Add(finalNode);

                return finalNode;
            }
        }
    }
    
    protected override void OnInitialized()
    {
        NavRegistry.OnChanged += HandleChange;
        NavRegistry.RegisterStatic("API", "API", order: -10);
        NavRegistry.RegisterStatic("Guides", "Guides", order: -9);
        NavRegistry.RegisterStatic("GettingStarted", "Guides/GettingStarted", order: -9);
        NavRegistry.RegisterStatic("RCS", "RCS", order: 10);
        NavRegistry.RegisterStatic("RERL", "RERL", order: 11);
    }

    void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavRegistry.OnChanged -= HandleChange;
    }
}